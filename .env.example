# Optional. Without these values the pipeline runs its deterministic, schema-valid fallback.
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_API_KEY=replace-me
LLM_MODEL=your-model-id
# Keep a slow/free provider from delaying the required 30-minute submission run.
XPERT_LLM_TIMEOUT=45
XPERT_LLM_RETRIES=1
# Recommended for local Qwen3 through Ollama.
XPERT_DISABLE_THINKING=true
# Local Qwen processes one compact candidate per request. Increase slowly (for example, 9)
# to trade runtime for open-loop recall.
XPERT_LOCAL_CANDIDATES=3
# Strong remote models can review a broader ranked shortlist in batches of six.
XPERT_REMOTE_CANDIDATES=36
# Set for providers that reject OpenAI's response_format JSON mode (for example, some Gemini routes).
XPERT_DISABLE_JSON_MODE=true
# For Gemini 3.x development when its OpenAI compatibility route does not return completions.
XPERT_GEMINI_INTERACTIONS=true
